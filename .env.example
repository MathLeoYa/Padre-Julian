# ============================================================
# VARIABLES DE ENTORNO - Dashboard Gerencial PMO
# Copia este archivo como .env y completa los valores reales
# ============================================================

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos del Dashboard (SQLite por defecto para desarrollo) ---
# Para producción usar PostgreSQL o MySQL
DATABASE_URL=sqlite:///db.sqlite3

# --- Conexión a Redmine (MySQL, solo lectura) ---
REDMINE_DB_HOST=localhost
REDMINE_DB_PORT=3306
REDMINE_DB_NAME=redmine
REDMINE_DB_USER=redmine_reader
REDMINE_DB_PASSWORD=

# --- API de Redmine ---
REDMINE_URL=http://localhost:3000
REDMINE_API_KEY=

# --- Celery / Redis (scheduler y tareas en segundo plano) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Notificaciones por correo ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dashboard@cooperativa.com

# --- Rocket.Chat (opcional) ---
ROCKETCHAT_URL=http://localhost:3001
ROCKETCHAT_USER=
ROCKETCHAT_PASSWORD=
ROCKETCHAT_CHANNEL=#general
